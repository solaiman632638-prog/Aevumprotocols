NEXT_PUBLIC_APP_URL=http://localhost:3002

# Accounts and sync (Supabase). Vercel's Supabase integration sets these for you.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Aevum AI (server-side only — never NEXT_PUBLIC)
OPENAI_API_KEY=
# Optional: overrides the model. Leave unset to use the built-in default.
OPENAI_MODEL=

# Admin page (/admin) — server-side only, never NEXT_PUBLIC.
# Supabase → Project Settings → API keys → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed to open /admin.
ADMIN_EMAILS=
