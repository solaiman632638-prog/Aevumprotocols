NEXT_PUBLIC_APP_URL=http://localhost:3002

# Accounts and sync (Supabase). Vercel's Supabase integration sets these for you.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Aevum AI (server-side only — never NEXT_PUBLIC)
OPENAI_API_KEY=
# Optional: overrides the model. Leave unset to use the built-in default.
OPENAI_MODEL=

# Admin page (/admin) — server-side only, never NEXT_PUBLIC.
# Supabase → Project Settings → API keys → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed to open /admin.
ADMIN_EMAILS=

# Call booking emails (/book) — server-side only. Same Resend account as the NovaEvum store.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. Aevum <bookings@novaevum.ca>
EMAIL_FROM=
# Optional: who hears about bookings (comma-separated). Defaults to ADMIN_EMAILS.
BOOKING_NOTIFY_EMAIL=
